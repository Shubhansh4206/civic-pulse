# CivicPulse Environment Configuration
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@localhost:5432/civicpulse_db
APP_NAME=CivicPulse
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Computer Vision
YOLO_MODEL_PATH=models/yolov8_civic.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_DEVICE=cpu

# Score Fusion Weights
FUSION_TEXT_WEIGHT=0.50
FUSION_VISUAL_WEIGHT=0.50
CRITICAL_SYNERGY_THRESHOLD=0.80
CRITICAL_SYNERGY_BOOST=0.10

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
ROBOFLOW_API_KEY=your_roboflow_key