# CivicPulse Environment Configuration
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@localhost:5432/civicpulse_db
APP_NAME=CivicPulse
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Computer Vision
YOLO_MODEL_PATH=models/yolov8_civic.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_DEVICE=cpu

# Score Fusion Weights
FUSION_TEXT_WEIGHT=0.50
FUSION_VISUAL_WEIGHT=0.50
CRITICAL_SYNERGY_THRESHOLD=0.80
CRITICAL_SYNERGY_BOOST=0.10

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
ROBOFLOW_API_KEY=your_roboflow_key
# Optional department routing; migrate storage before deploying this version
ROUTING_ENABLED=True
ROUTING_MODEL_PATH=models/department_router/router.joblib
ROUTING_CONFIDENCE_THRESHOLD=0.60
ROUTING_FALLBACK_DEPARTMENT=MANUAL_REVIEW

SEMANTIC_DUPLICATES_ENABLED=True
SEMANTIC_DUPLICATE_RADIUS_METERS=5.0
SEMANTIC_DUPLICATE_THRESHOLD=0.80

# Image-text consistency (advisory)
CLIP_ENABLED=True
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLIP_CONSISTENCY_THRESHOLD=0.20
